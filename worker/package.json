{
  "name": "@corridas/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:integration": "vitest run test"
  },
  "dependencies": {
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
